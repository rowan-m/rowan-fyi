{
  "name": "out-out",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "npm run format:check && npm run lint && npm run lint:sonar && npm run lint:security && npm run typecheck && npm run depcruise && npm run build && npm run test",
    "depcruise": "depcruise src",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "lint:security": "eslint src astro.config.mjs -c eslint.security.config.js",
    "lint:sonar": "eslint src -c eslint.sonar.config.js",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/node": "^11.1.14",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@sd-jwt/core": "^0.25.1",
    "astro": "^7.4.13",
    "dompurify": "^3.5.0",
    "http-message-sig": "^0.3.0",
    "jose": "^6.2.18",
    "lit": "^3.3.3",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "sharp": "0.35.5",
    "structured-headers": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-packagejson": "^3.1.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
