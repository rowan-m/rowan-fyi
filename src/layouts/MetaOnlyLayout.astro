---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import CommonMeta from "@/components/CommonMeta.astro";
import { extractMadeSlugFromPath, findPostForSlug, selectProjectImage } from "@/pages/made/_projects";

interface Props {
  title: string;
  description: string;
  pubDate?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, description, pubDate, image, imageAlt } = Astro.props;

const rawLocalImages = import.meta.glob<{ default: ImageMetadata }>("../pages/made/**/*.{png,jpg,jpeg,webp,gif}", {
  eager: true,
});
const localImages: Record<string, { default: ImageMetadata }> = {};
for (const [key, mod] of Object.entries(rawLocalImages)) {
  localImages[key.replace(/^\.\.\/pages\/made\//, "./")] = mod;
}

const slug = extractMadeSlugFromPath(Astro.url.pathname);
const matchingPost = slug ? findPostForSlug(slug, await getCollection("posts")) : undefined;
const resolvedImage = image ?? (slug ? selectProjectImage(slug, localImages, matchingPost?.data.image) : undefined);
const resolvedImageAlt = imageAlt ?? matchingPost?.data.imageAlt;
const resolvedPubDate = pubDate ?? matchingPost?.data.pubDate.toISOString().slice(0, 10);
const baseSite = Astro.site ?? new URL("https://rowan.fyi");
---

<!doctype html>
<html lang="en">
  <CommonMeta />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, baseSite)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {resolvedPubDate && <meta property="article:published_time" content={resolvedPubDate} />}
  {resolvedImage && (
    <>
      <meta name="image" property="og:image" content={new URL(resolvedImage.src, baseSite)} />
      <meta property="og:image:width" content={String(resolvedImage.width)} />
      <meta property="og:image:height" content={String(resolvedImage.height)} />
    </>
  )}
  {resolvedImage && resolvedImageAlt && <meta property="og:image:alt" content={resolvedImageAlt} />}
  <slot name="head" />
  <slot />
</html>
