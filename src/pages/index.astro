---
export const prerender = true;

import type { ImageMetadata } from "astro";
import CardView from "@/components/CardView.astro";
import DefaultHead from "@/components/DefaultHead.astro";
import DefaultBodyLayout from "@/layouts/DefaultBodyLayout.astro";
import { Image } from "astro:assets";
import imgRowanMerewood from "@/assets/rowan-merewood.jpg";
import { buildFeedList } from "./made/_projects";

import { getCollection } from "astro:content";

const title = "rowan.fyi";
const description =
  "Rowan Merewood's site featuring a variety of web development projects and posts ranging over graphics, mathematics, optical illusions, and art.";

const profileData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  dateCreated: "2025-05-06T00:00:00+00:00",
  mainEntity: {
    "@type": "Person",
    name: "Rowan Merewood",
    description:
      "Developer, Developer Relations, and manager - sometimes all at once. Projects and posts ranging over graphics, mathematics, optical illusions, and art. Works on Chrome at Google.",
    image: new URL(imgRowanMerewood.src, Astro.site),
    sameAs: [
      "https://bsky.app/profile/rowan.fyi",
      "https://mastodon.social/@rowan_m",
      "https://glitch.com/@rowan-m",
      "https://github.com/rowan-m/",
      "https://www.threads.com/@rowan_m",
      "https://www.linkedin.com/in/rowanmerewood/",
      "https://www.instagram.com/rowan_m/",
    ],
  },
};

const rawSources = import.meta.glob<string>("./made/*/index.astro", {
  query: "?raw",
  import: "default",
  eager: true,
});

const localImages = import.meta.glob<{ default: ImageMetadata }>("./made/**/*.{png,jpg,jpeg,webp}", { eager: true });

const posts = await getCollection("posts");
const feedList = buildFeedList(rawSources, localImages, posts);
---

<!doctype html>
<html lang="en">
  <head>
    <DefaultHead title={title} description={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(profileData)}></script>
    <meta property="og:url" content={new URL(Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="image" property="og:image" content={new URL("img/og-preview.png", Astro.site)} />
  </head>
  <DefaultBodyLayout useH1Header={true}>
    <style>
      .posts > div {
        display: flex;
        flex-flow: row wrap;
        gap: 1ch;
      }
    </style>
    <main class="h-card">
      <a class="u-url" href="/" style="display: none">
        <Image src={imgRowanMerewood} alt="Rowan Merewood" width="800" class="u-photo" />
      </a>
      <p>
        <span class="p-note">
          Hello there, I'm <span class="p-name">Rowan Merewood</span> and <a href="/">rowan.fyi</a> is where I share my
          various projects and posts ranging over graphics, mathematics, optical illusions, and arguably art. At work,
          I'm Developer Relations for <a href="https://developer.chrome.com/">Chrome</a> at Google.
        </span>
      </p>
      <section class="posts">
        <h2>Posts &amp; Projects</h2>
        <div>
          {feedList.map((item) => (
            <CardView
              href={item.href}
              title={item.title}
              description={item.description}
              image={item.image}
              imageAlt={item.imageAlt}
              pubDate={item.pubDate}
            />
          ))}
        </div>
      </section>
    </main>
  </DefaultBodyLayout>
</html>
