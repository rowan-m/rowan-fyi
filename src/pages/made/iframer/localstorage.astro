---
export const prerender = true;

import MetaOnlyLayout from "@/layouts/MetaOnlyLayout.astro";
---

<MetaOnlyLayout title="LocalStorage 🖼 iframer" description="LocalStorage in cross-origin iframes.">
  <link rel="icon" href="data:;base64,iVBORw0KGgo=" />
  <style is:inline>
    iframe {
      width: 100%;
      height: 35rem;
    }
  </style>
  <h1>LocalStorage 🖼 iframer</h1>
  <iframe title="Cross-origin localStorage test" src="https://rowan.fyi/made/x-origin-src/localstorage/"></iframe>
  <script is:inline>
    "use strict";
    if (location.protocol !== "https:" && location.hostname !== "localhost") {
      location.protocol = "https:";
    }
  </script></MetaOnlyLayout>
