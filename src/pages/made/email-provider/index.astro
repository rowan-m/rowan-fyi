---
export const prerender = false;

import MetaOnlyLayout from "@/layouts/MetaOnlyLayout.astro";

const cookieName = "__session";
let isLoggedIn = Astro.cookies.get(cookieName)?.value === "active";

let triggerLoginStatusUpdate: "logged-in" | "logged-out" | null = null;

if (Astro.request.method === "POST") {
  // CSRF protection: the session cookie below is SameSite=None, so the browser will
  // attach it to cross-site requests and SameSite can no longer defend this form.
  // Instead we check Fetch Metadata: a real form submission from this page is
  // "same-origin", while a cross-site auto-submitted form is "cross-site".
  // (Older browsers omit Sec-Fetch-Site entirely, so a missing header is allowed.)
  const secFetchSite = Astro.request.headers.get("sec-fetch-site");
  const isSameOriginRequest = !secFetchSite || secFetchSite === "same-origin" || secFetchSite === "none";

  if (!isSameOriginRequest) {
    return new Response("Cross-site session changes are not allowed.", { status: 403 });
  }

  const formData = await Astro.request.formData();
  const action = formData.get("action");

  if (action === "login") {
    Astro.cookies.set(cookieName, "active", {
      path: "/",
      // SameSite=None is REQUIRED, not incidental. The browser fetches the FedCM
      // accounts endpoint and the EVP issuance endpoint itself, on behalf of a
      // relying party page that is usually on a different site. Those credentialed
      // requests are cross-site, so a Lax cookie would never be sent and this issuer
      // would always look logged out. It only appears to work with Lax when the
      // relying party happens to share this site, as the sibling verifier demo does.
      sameSite: "none",
      secure: true,
      maxAge: 3600, // 1 hour
    });
    isLoggedIn = true;
    triggerLoginStatusUpdate = "logged-in";
    Astro.response.headers.set("Set-Login", "logged-in");
  } else if (action === "logout") {
    Astro.cookies.delete(cookieName, { path: "/" });
    isLoggedIn = false;
    triggerLoginStatusUpdate = "logged-out";
    Astro.response.headers.set("Set-Login", "logged-out");
  }
}
---

<MetaOnlyLayout
  title="Email provider - Email Verification Protocol (EVP) demo"
  description="Demo of an Email Verification Protocol (EVP) Issuer"
>
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Email provider - Email Verification Protocol (EVP) demo" />
  <meta property="og:description" content="Demo of an Email Verification Protocol (EVP) Issuer" />
  <link
    rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📧</text></svg>"
  />
  <style>
    html {
      font-family: sans-serif;
    }

    /* Container layout */
    .evp-demo-container {
      max-width: 800px;
      margin: 3rem auto;
      padding: 0 1.5rem;
      color: #333;
      line-height: 1.5;
    }

    .evp-demo-container h1 {
      font-size: 2.2em;
      margin-top: 0;
      margin-bottom: 0.5rem;
      color: #111;
      letter-spacing: -0.5px;
    }

    .evp-intro-text {
      color: #555;
      font-size: 1.1em;
      margin-top: 0;
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .evp-github-link {
      color: #6c757d;
      font-size: 0.9em;
      margin-top: 2rem;
      border-top: 1px solid #dee2e6;
      padding-top: 1rem;
    }

    /* State Panels */
    .status-panel {
      padding: 1.5rem;
      border-radius: 4px;
      border: 1px solid;
      margin-bottom: 2rem;
    }
    .status-panel p {
      margin-top: 0;
      margin-bottom: 1.2rem;
      font-size: 1.1em;
    }

    .status-panel.logged-in {
      background-color: #e2f0d9;
      border-color: #385723;
      color: #385723;
    }
    .status-panel.logged-out {
      background-color: #f8f9fa;
      border-color: #ddd;
      color: #555;
    }

    /* Buttons */
    .btn {
      padding: 0.6rem 1.4rem;
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      box-sizing: border-box;
      transition: background-color 0.2s;
    }
    .btn-danger {
      background-color: #c00000;
    }
    .btn-danger:hover {
      background-color: #800000;
    }
    .btn-primary {
      background-color: #0056b3;
    }
    .btn-primary:hover {
      background-color: #004085;
    }

    .evp-setup-notice {
      background-color: #f8f9fa;
      border: 1px solid #e9ecef;
      padding: 0.5rem 0.8rem;
      border-radius: 4px;
      margin: 0.6rem 0;
      font-size: 0.9em;
      color: #495057;
      line-height: 1.4;
    }
  </style>

  <main class="evp-demo-container">
    <h1>Email provider - Email Verification Protocol (EVP) demo</h1>
    <p class="evp-setup-notice">
      <strong
        >📣 Read the <a href="https://developer.chrome.com/blog/email-verification-protocol-origin-trial"
          >announcement and implementation guide</a
        >.</strong
      >
    </p>
    <p class="evp-intro-text">
      This is a mock email provider for the <a href="https://github.com/WICG/email-verification"
        >Email Verification API</a
      > and <a href="https://github.com/dickhardt/email-verification">protocol</a>. It plays the issuer: the party that
      already knows the address is yours and will vouch for it. Once you've signed in, use the <a
        href="/made/email-verification/">relying party demo</a
      > to verify the address.
    </p>

    {
      isLoggedIn ? (
        <div class="status-panel logged-in">
          <p>
            Current Session: Logged in as <strong>demo@rowan.fyi</strong>
          </p>
          <form method="POST">
            <input type="hidden" name="action" value="logout" />
            <button type="submit" class="btn btn-danger">
              Log out
            </button>
          </form>
        </div>
      ) : (
        <div class="status-panel logged-out">
          <p>Current Session: Not logged in</p>
          <form method="POST">
            <input type="hidden" name="action" value="login" />
            <button type="submit" class="btn btn-primary">
              Log in as demo@rowan.fyi
            </button>
          </form>
        </div>
      )
    }
    <p class="evp-setup-notice">
      Signing in here does two things: it sets a session cookie, and it calls <code>navigator.login.setStatus()</code> to
      tell the browser this provider has a signed-in user. Without that second step the browser will not even ask this provider
      for a token.
    </p>
    <p class="evp-github-link">
      🧑‍💻 View the code for the demo on <a
        href="https://github.com/rowan-m/rowan-fyi/tree/main/src/pages/made/email-provider"
        target="_blank">GitHub</a
      >
    </p>
  </main>

  <script is:inline define:vars={{ triggerLoginStatusUpdate }}>
    // Synchronize browser's login status with the Issuer session
    // This is required for FedCM accounts-discovery and verification steps.
    // We ONLY invoke setStatus when an explicit action (login/logout) was performed, NOT on standard GET requests.
    if (triggerLoginStatusUpdate && navigator.login && navigator.login.setStatus) {
      navigator.login
        .setStatus(triggerLoginStatusUpdate)
        .then(() => console.log(`navigator.login.setStatus(${triggerLoginStatusUpdate})`))
        .catch((err) => console.error(`navigator.login.setStatus(${triggerLoginStatusUpdate}) error:`, err));
    }
  </script>
</MetaOnlyLayout>
