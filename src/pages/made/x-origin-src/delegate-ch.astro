---
export const prerender = true;

import MetaOnlyLayout from "@/layouts/MetaOnlyLayout.astro";
import crossOriginImage from "./assets/cross-origin-image.png";
import waterCssUrl from "./_water.css?url";
---

<MetaOnlyLayout title="Delegate-CH example" description="Delegate-CH meta tag example.">
  <meta
    http-equiv="Accept-CH"
    content="Sec-CH-Downlink, Sec-CH-DPR, Sec-CH-Viewport-Width, Sec-CH-Width, Sec-CH-UA-Platform-Version"
  />
  <meta http-equiv="Accept-CH" content="Downlink, DPR, Viewport-Width, Width" />

  <meta
    http-equiv="Delegate-CH"
    content="sec-ch-downlink https://cdn.glitch.global; sec-ch-dpr https://cdn.glitch.global; sec-ch-viewport-width https://cdn.glitch.global; sec-ch-width https://cdn.glitch.global; Sec-CH-UA-Platform-Version https://cdn.glitch.global"
  />
  <meta
    http-equiv="Delegate-CH"
    content="downlink https://cdn.glitch.global; dpr https://cdn.glitch.global; viewport-width https://cdn.glitch.global; width https://cdn.glitch.global;"
  />

  <link rel="icon" href="data:;base64,iVBORw0KGgo=" />
  <link rel="stylesheet" type="text/css" href={waterCssUrl} />
  <h1>Delegate-CH example</h1>
  <img width="1500" height="500" src={crossOriginImage.src} alt="Give me a hint, please!" />
</MetaOnlyLayout>
