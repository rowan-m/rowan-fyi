---
export const prerender = false;

import MetaOnlyLayout from "@/layouts/MetaOnlyLayout.astro";

const timestamp = Date.now();
Astro.response.headers.set("Set-Cookie", `3pc=${timestamp}; Path=/; Secure; SameSite=None`);
---

<MetaOnlyLayout title="Setting a third-party cookie" description="Setting a third-party cookie.">
  <link
    rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>➕</text></svg>"
  />
  <style is:inline>
    body,
    p {
      margin: 0.1rem;
      padding: 0.1rem;
    }
  </style>
  <p>
    Attempting to set a cookie from <br /><code>https://rowan.fyi/made/x-origin-src/set-3pc/</code>:
    <br /><code>Set-Cookie: 3pc={timestamp}; SameSite=None; Path=/; Secure</code>
  </p>
  <script is:inline>
    "use strict";
    if (location.protocol !== "https:" && location.hostname !== "localhost") {
      location.protocol = "https:";
    }
  </script></MetaOnlyLayout>
