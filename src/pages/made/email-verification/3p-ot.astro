---
export const prerender = false;

import MetaOnlyLayout from "@/layouts/MetaOnlyLayout.astro";
import { SDJwtInstance, decodeSdJwtSync } from "@sd-jwt/core";
import { importJWK, compactVerify } from "jose";
import type { JWK } from "jose";
import { createHash, randomUUID } from "node:crypto";
import dns from "node:dns/promises";

interface VerificationResult {
  email: string;
  evt: Record<string, unknown>;
  kb: Record<string, unknown>;
}

interface EvtPayload {
  email: string;
  email_verified?: boolean;
  cnf?: {
    jwk?: JWK;
  };
  exp?: number;
  iat?: number;
}

interface TraceStep {
  name: string;
  description: string;
  serverCalled?: string;
  inputSent?: unknown;
  outputReceived?: unknown;
  status: "success" | "failed" | "pending";
  error?: string;
}

/**
 * Validates standard JWT claims including expiration, issued-at presence, and freshness window.
 */
function validateClaims(payload: Record<string, unknown>, maxAgeSeconds = 300, clockSkewSeconds = 60) {
  const currentTime = Math.floor(Date.now() / 1000);
  const exp = typeof payload.exp === "number" ? payload.exp : undefined;
  const iat = typeof payload.iat === "number" ? payload.iat : undefined;

  if (exp && currentTime > exp + clockSkewSeconds) {
    throw new Error(`The token has expired (exp: ${exp}, current: ${currentTime}).`);
  }
  if (!iat) {
    throw new Error("Required issued-at ('iat') claim is missing.");
  }
  if (exp && iat >= exp) {
    throw new Error(`Token timestamps are inconsistent (iat: ${iat} >= exp: ${exp}).`);
  }
  const age = currentTime - iat;
  if (age > maxAgeSeconds + clockSkewSeconds) {
    throw new Error(`Token is too old (issued ${age} seconds ago, max limit: ${maxAgeSeconds}s).`);
  }
  if (age < -clockSkewSeconds) {
    throw new Error(`Token has a future issuance timestamp (iat: ${iat}, current: ${currentTime}).`);
  }
}

let verificationResult: VerificationResult | null = null;
let errorMsg = "";

// Cookie and Nonce Configuration
const nonceCookieName = "evp_rp_nonce";
let expectedNonce = Astro.cookies.get(nonceCookieName)?.value;

// Initialize the 6-Step Verification Trace Array
let traceSteps: TraceStep[] = [
  {
    name: "Step 1: Parse the token",
    description:
      "Parse the submitted token into its EVT and Key Binding JWT (KB-JWT) components, and decode their headers and payloads.",
    status: "pending",
  },
  {
    name: "Step 2: Validate expected values and session binding",
    description:
      "Verify the email address and verification status claims match the form submission before running cryptographic checks.",
    status: "pending",
  },
  {
    name: "Step 3: Validate DNS record",
    description:
      "Query the domain's DNS TXT record to check if it delegates verification authority to the token issuer.",
    status: "pending",
  },
  {
    name: "Step 4: Issuer discovery & JWKS fetching",
    description: "Fetch the issuer's well-known configuration and JWKS public keys from their authoritative origin.",
    status: "pending",
  },
  {
    name: "Step 5: Issuer signature verification",
    description: "Verify the EVT signature using the fetched issuer public keys.",
    status: "pending",
  },
  {
    name: "Step 6: Ephemeral key binding verification",
    description: "Verify the KB-JWT signature, session nonce, audience, and token hash using @sd-jwt/core.",
    status: "pending",
  },
];

let activeTrace: TraceStep[] | null = null;

if (Astro.request.method === "POST") {
  activeTrace = traceSteps;
  try {
    // Replay Protection: Consume and delete the nonce cookie immediately upon POST receipt.
    Astro.cookies.delete(nonceCookieName, { path: "/" });

    const formData = await Astro.request.formData();
    const submittedEmail = ((formData.get("email") as string) || "").trim();
    const rawToken = ((formData.get("token") as string) || "").trim();

    if (rawToken) {
      // ==============================================================================
      // STEP 1: TOKEN PARSING
      // ==============================================================================
      traceSteps[0].inputSent = { rawToken };

      const hasher = (data, alg) =>
        createHash(alg === "sha-256" ? "sha256" : alg)
          .update(data)
          .digest();

      let decodedSdJwt;
      try {
        decodedSdJwt = decodeSdJwtSync(rawToken, hasher);
      } catch (e) {
        traceSteps[0].status = "failed";
        throw new Error(`Invalid token format: ${(e as Error).message}`, { cause: e });
      }

      if (!decodedSdJwt.kbJwt) {
        traceSteps[0].status = "failed";
        throw new Error("Missing Key Binding JWT (KB-JWT).");
      }

      const evtJwtDecodedPayload = decodedSdJwt.jwt.payload as EvtPayload;
      const iss = evtJwtDecodedPayload.iss;
      if (!iss) {
        traceSteps[0].status = "failed";
        throw new Error("EVT is missing the issuer ('iss') claim.");
      }

      traceSteps[0].outputReceived = {
        evtJwtDecodedHeader: decodedSdJwt.jwt.header,
        evtJwtDecodedPayload,
        kbJwtDecodedHeader: decodedSdJwt.kbJwt.header,
        kbJwtDecodedPayload: decodedSdJwt.kbJwt.payload,
        disclosures: decodedSdJwt.disclosures,
      };
      traceSteps[0].status = "success";

      // ==============================================================================
      // STEP 2: VERIFY EXPECTED VALUES AND SESSION BINDING
      // ==============================================================================
      const expectedAudience = Astro.url.origin;

      traceSteps[1].inputSent = {
        submittedEmail,
        tokenEmail: evtJwtDecodedPayload.email,
        emailVerifiedClaim: evtJwtDecodedPayload.email_verified,
      };

      if (evtJwtDecodedPayload.email.toLowerCase() !== submittedEmail.toLowerCase()) {
        traceSteps[1].status = "failed";
        throw new Error(
          `Email mismatch: Form input is ${submittedEmail}, but token holds ${evtJwtDecodedPayload.email}.`,
        );
      }

      if (evtJwtDecodedPayload.email_verified !== true) {
        traceSteps[1].status = "failed";
        throw new Error("Security Exception: The token 'email_verified' claim must be explicitly true.");
      }

      traceSteps[1].outputReceived = {
        localChecksPassed: true,
        details: "Local claims matched. Cryptographic and token binding validation will be performed by the library.",
      };
      traceSteps[1].status = "success";

      // ==============================================================================
      // STEP 3: DNS DELEGATION & AUTHORITY VERIFICATION (NETWORK)
      // ==============================================================================
      const domain = submittedEmail.split("@")[1];
      traceSteps[2].inputSent = { submittedEmail, tokenIssuer: iss, dnsLookupTarget: `_email-verification.${domain}` };

      let isAuthoritative = false;
      const issuerHost = iss.startsWith("http") ? new URL(iss).hostname.toLowerCase() : iss.toLowerCase();

      if (domain.toLowerCase() === issuerHost) {
        isAuthoritative = true;
        traceSteps[2].outputReceived = {
          authorizedBy: "Direct Domain Equality (Self-Authoritative)",
          details: "Email domain directly matches the token issuer host.",
        };
      } else {
        traceSteps[2].serverCalled = "System DNS Server (TXT Resolve)";
        try {
          const records = await dns.resolveTxt(`_email-verification.${domain}`);
          traceSteps[2].outputReceived = { dnsTxtRecords: records };

          for (const record of records) {
            const txt = record.join("");
            if (txt.startsWith("iss=")) {
              const delegatedIssuer = txt.substring(4);
              const delegatedHost = delegatedIssuer.startsWith("http")
                ? new URL(delegatedIssuer).hostname.toLowerCase()
                : delegatedIssuer.toLowerCase();
              if (delegatedHost === issuerHost) {
                isAuthoritative = true;
                break;
              }
            }
          }
        } catch (dnsErr) {
          traceSteps[2].status = "failed";
          throw new Error(
            `DNS delegation lookup failed for _email-verification.${domain}: ${(dnsErr as Error).message}`,
            { cause: dnsErr },
          );
        }
      }

      if (!isAuthoritative) {
        traceSteps[2].status = "failed";
        throw new Error(
          `Security Exception: Issuer '${iss}' is not authoritative for the email domain of '${submittedEmail}'.`,
        );
      }
      traceSteps[2].status = "success";

      // ==============================================================================
      // STEP 4: ISSUER DISCOVERY & JWKS FETCHING (NETWORK)
      // ==============================================================================
      const discoveryUrl = `${iss}/.well-known/email-verification`;
      traceSteps[3].serverCalled = discoveryUrl;
      traceSteps[3].inputSent = { url: discoveryUrl };

      const metadataResponse = await fetch(discoveryUrl);
      if (!metadataResponse.ok) {
        traceSteps[3].status = "failed";
        throw new Error(`Failed to discover issuer metadata at ${discoveryUrl}: ${metadataResponse.statusText}`);
      }
      const metadata = await metadataResponse.json();
      traceSteps[3].outputReceived = { issuerMetadata: metadata };

      const jwksUri = metadata.jwks_uri;
      if (!jwksUri) {
        traceSteps[3].status = "failed";
        throw new Error(`Issuer metadata at ${discoveryUrl} is missing 'jwks_uri'.`);
      }

      traceSteps[3].serverCalled = `${discoveryUrl} & ${jwksUri}`;
      const jwksResponse = await fetch(jwksUri);
      if (!jwksResponse.ok) {
        traceSteps[3].status = "failed";
        throw new Error(`Failed to fetch JWKS from ${jwksUri}`);
      }
      const jwksData = await jwksResponse.json();
      traceSteps[3].outputReceived = { issuerMetadata: metadata, issuerJWKS: jwksData };
      traceSteps[3].status = "success";

      // ==============================================================================
      // STEP 5 & 6: CRYPTOGRAPHIC VERIFICATION
      // ==============================================================================
      traceSteps[4].inputSent = { signingAlg: decodedSdJwt.jwt.header.alg || "ES256" };
      traceSteps[5].inputSent = { cnf: evtJwtDecodedPayload.cnf };

      let verifiedEvtPayload;

      try {
        const sdJwt = new SDJwtInstance({ hasher });
        sdJwt.config({
          hasher,
          verifier: async (data, sig) => {
            const token = `${data}.${sig}`;
            const headerAlg = decodedSdJwt.jwt.header.alg || "ES256";
            const kid = decodedSdJwt.jwt.header.kid;
            // Filter keys by kid if present. If kid is missing (e.g., GMail JWKS), trial-verify using all keys.
            const keysToTry = kid ? jwksData.keys.filter((k: { kid?: string }) => k.kid === kid) : jwksData.keys;

            for (const jwk of keysToTry) {
              try {
                const pubKey = await importJWK(jwk as JWK, jwk.alg || headerAlg);
                await compactVerify(token, pubKey);
                return true;
              } catch {
                continue;
              }
            }
            return false;
          },
          kbVerifier: async (data, sig) => {
            try {
              const browserJwkKey = evtJwtDecodedPayload.cnf?.jwk;
              if (!browserJwkKey) throw new Error("Missing browser ephemeral public key.");
              const pubKey = await importJWK(browserJwkKey as JWK, decodedSdJwt.kbJwt.header.alg || "ES256");
              await compactVerify(`${data}.${sig}`, pubKey);
              return true;
            } catch {
              return false;
            }
          },
        });

        const result = await sdJwt.verify(rawToken, {
          kb: {
            expectedNonce,
            expectedAudience,
            required: true,
          },
        });

        verifiedEvtPayload = result.payload;

        // ==============================================================================
        // STRICT TIMESTAMP AND CLAIM VALIDATIONS (AFTER CRYPTOGRAPHIC VERIFICATION)
        // ==============================================================================
        try {
          validateClaims(verifiedEvtPayload, 300);
        } catch (err: unknown) {
          traceSteps[4].status = "failed";
          throw err;
        }

        try {
          validateClaims(decodedSdJwt.kbJwt.payload as Record<string, unknown>, 300);
        } catch (err: unknown) {
          traceSteps[5].status = "failed";
          throw err;
        }

        traceSteps[4].outputReceived = { cryptographicallyVerified: true };
        traceSteps[4].status = "success";
        traceSteps[5].outputReceived = {
          keyBindingPassed: true,
          holderVerification: "Holder Private Key possession verified.",
          claimsVerified:
            "EVT freshness (and optional expiration) and KB-JWT expiration and freshness claims successfully verified.",
        };
        traceSteps[5].status = "success";
      } catch (err) {
        traceSteps[4].status = "failed";
        traceSteps[5].status = "failed";
        throw new Error(`Cryptographic Verification Failed: ${(err as Error).message}`, { cause: err });
      }

      verificationResult = {
        email: verifiedEvtPayload.email as string,
        evt: verifiedEvtPayload as unknown as Record<string, unknown>,
        kb: decodedSdJwt.kbJwt.payload as unknown as Record<string, unknown>,
      };
    } else {
      errorMsg =
        "No verification token was sent by the browser. Site should fall back to alternatives, e.g. magic link or OTP in email.";
    }
  } catch (e) {
    const errorMsgText = e instanceof Error ? e.message : "Failed to verify the token.";
    Astro.logger.error(`Verification error: ${errorMsgText}`);
    errorMsg = errorMsgText;

    // Auto-mark the currently active step as failed with its exact error context
    const currentStep = traceSteps.find((s) => s.status === "pending" || s.status === "failed");
    if (currentStep) {
      currentStep.status = "failed";
      currentStep.error = errorMsg;
    }
  }
}

// Always generate a fresh nonce for the next page render
const activeNonce = randomUUID();
Astro.cookies.set(nonceCookieName, activeNonce, {
  path: "/",
  httpOnly: true,
  secure: true,
  sameSite: "lax",
  maxAge: 300, // 5 minutes
});
---

<MetaOnlyLayout
  title="Email Verification Protocol (EVP) demo"
  description="Demo of an Email Verification Protocol (EVP) Relying Party"
>
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Email Verification Protocol (EVP) demo" />
  <meta property="og:description" content="Demo of an Email Verification Protocol (EVP) Relying Party" />
  <meta name="twitter:card" content="summary" />
  <meta property="twitter:domain" content="rowan.fyi" />
  <meta property="twitter:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta name="twitter:title" content="Email Verification Protocol (EVP) demo" />
  <meta name="twitter:description" content="Demo of an Email Verification Protocol (EVP) Relying Party" />
  <script is:inline src="https://merewood.org/email-verification/3p-ot.js"></script>
  <link
    rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📧</text></svg>"
  />
  <style>
    html {
      font-family: sans-serif;
    }

    /* Container layout */
    main {
      max-width: 800px;
      margin: 1.5rem auto;
      padding: 0 1.5rem;
      color: #333;
      line-height: 1.5;
    }

    h1 {
      font-size: 2em;
      margin-top: 0;
      margin-bottom: 0.4rem;
      color: #111;
      letter-spacing: -0.5px;
    }

    /* Intro Typography styling */
    .evp-intro-text {
      color: #555;
      font-size: 1.1em;
      line-height: 1.5;
      margin-top: 0;
      margin-bottom: 1rem;
    }

    /* Highlight box for prerequisites and setup */
    .evp-setup-notice {
      background-color: #f8f9fa;
      border: 1px solid #e9ecef;
      padding: 0.5rem 0.8rem;
      border-radius: 4px;
      margin: 0.6rem 0;
      font-size: 0.9em;
      color: #495057;
      line-height: 1.4;
    }

    /* Instruction text */
    .evp-instruction {
      font-weight: bold;
      color: #444;
      margin-top: 1.2rem;
      margin-bottom: 0.6rem;
    }

    /* GitHub link structure */
    .evp-github-link {
      color: #6c757d;
      font-size: 0.9em;
      margin-top: 1.5rem;
      border-top: 1px solid #dee2e6;
      padding-top: 0.8rem;
    }

    /* Form styling */
    .evp-form {
      display: flex;
      gap: 1rem;
      align-items: flex-end;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-weight: bold;
      margin-bottom: 0.4rem;
      font-size: 0.9em;
      color: #555;
    }

    .form-group input[type="email"] {
      padding: 0.6rem 0.8rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 1rem;
      width: 320px;
      max-width: 100%;
      outline: none;
      box-sizing: border-box;
      transition:
        border-color 0.2s,
        box-shadow 0.2s;
    }

    .form-group input[type="email"]:focus {
      border-color: #0056b3;
      box-shadow: 0 0 0 3px rgba(0, 86, 179, 0.15);
    }

    .evp-form button[type="submit"] {
      padding: 0.6rem 1.4rem;
      background-color: #0056b3;
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      box-sizing: border-box;
      transition: background-color 0.2s;
    }

    .evp-form button[type="submit"]:hover {
      background-color: #004085;
    }

    .evp-form button[type="submit"]:disabled {
      background-color: #6c757d;
      cursor: not-allowed;
    }

    /* Message Boxes */
    .msg-box {
      margin-top: 1.5rem;
      padding: 1rem;
      border-radius: 4px;
      border: 1px solid;
    }
    .msg-box h3 {
      margin-top: 0;
      margin-bottom: 0.5rem;
    }
    .msg-box p {
      margin-bottom: 0;
      margin-top: 0;
    }
    .msg-box.success {
      background-color: #e2f0d9;
      border-color: #385723;
      color: #385723;
    }
    .msg-box.error {
      background-color: #fce4d6;
      border-color: #c00000;
      color: #c00000;
    }

    /* User Agent Support States */
    .ua-supported {
      color: #28a745;
    }
    .ua-unsupported {
      color: #dc3545;
    }

    /* Trace Section Container */
    .trace-container {
      margin-top: 2rem;
      border-top: 2px solid #ddd;
      padding-top: 1.5rem;
    }
    .trace-container h2 {
      margin-top: 0;
      color: #333;
    }
    .trace-container p {
      color: #666;
      font-size: 0.95em;
    }

    /* Trace List & Steps */
    .trace-list {
      padding-left: 0;
      list-style-type: none;
    }
    .trace-step {
      margin-bottom: 1rem;
      padding: 1rem;
      border: 1px solid #e2e3e5;
      border-radius: 4px;
      background-color: #f8f9fa;
    }
    .trace-step.success {
      border-color: #c3e6cb;
      background-color: #f4fcf7;
    }
    .trace-step.failed {
      border-color: #f5c6cb;
      background-color: #fff5f5;
    }

    .trace-step-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    .trace-step-title {
      margin: 0;
      font-size: 1.1em;
      color: #444;
    }
    .trace-step.success .trace-step-title {
      color: #1e5a2d;
    }
    .trace-step.failed .trace-step-title {
      color: #8a1c24;
    }

    /* Status Badges */
    .status-badge {
      font-size: 0.8em;
      font-weight: bold;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      color: #fff;
      text-transform: uppercase;
      background-color: #6c757d;
    }
    .trace-step.success .status-badge {
      background-color: #28a745;
    }
    .trace-step.failed .status-badge {
      background-color: #dc3545;
    }

    /* Descriptions & Exceptions */
    .trace-step-desc {
      margin: 0.5rem 0;
      font-size: 0.95em;
      color: #444;
      line-height: 1.4;
    }
    .trace-step-error {
      margin: 0.5rem 0 0 0;
      color: #c00000;
      font-size: 0.9em;
      font-weight: bold;
      background: #feebeb;
      padding: 0.5rem;
      border-radius: 4px;
    }

    /* Expandable Trace Details */
    .trace-details {
      margin-top: 0.75rem;
      color: #333;
      outline: none;
    }
    .trace-details summary {
      font-size: 0.85em;
      font-weight: bold;
      color: #0056b3;
      cursor: pointer;
    }
    .trace-details-content {
      margin-top: 0.5rem;
      padding: 0.75rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      background-color: #fff;
    }
    .trace-details-content p {
      margin: 0 0 0.75rem 0;
      font-size: 0.9em;
      line-height: 1.4;
    }
    .trace-details-content code {
      background-color: #f1f3f5;
      padding: 0.15rem 0.35rem;
      border-radius: 3px;
      font-size: 0.95em;
    }
    .trace-section-mb {
      margin-bottom: 0.75rem;
    }
    .trace-section-mb:last-child {
      margin-bottom: 0;
    }
    .trace-section-mb strong {
      font-size: 0.85em;
      color: #555;
    }
    .trace-details-content pre {
      margin: 0.25rem 0 0 0;
      padding: 0.5rem;
      border: 1px solid #e9ecef;
      border-radius: 4px;
      background-color: #f8f9fa;
      font-size: 0.85em;
      overflow-x: auto;
    }
  </style>
  <main>
    <h1>Email Verification demo</h1>
    <p class="evp-setup-notice">
      <strong
        >📣 Read the <a href="https://developer.chrome.com/blog/email-verification-protocol-origin-trial"
          >announcement and implementation guide</a
        >.</strong
      >
    </p>
    <p class="evp-intro-text">
      The <a href="https://github.com/WICG/email-verification">Email Verification API</a> and <a
        href="https://github.com/dickhardt/email-verification">protocol</a
      > form a proposal to allow the browser and email provider to communicate directly to verify an email address, letting
      you skip the magic link or OTP completely. Give it a try!
    </p>
    <p class="evp-setup-notice">
      Requires Chrome 150+, you're on <span id="ua-browser">[...]</span>&nbsp;
      <span id="ua-version">[...]</span>: the API is <strong><span id="ua-supported">[...]</span></strong>.
    </p>
    <p class="evp-setup-notice">
      <a href="/made/email-provider/" target="_blank">Sign in to the demo provider</a> to create a session for the <code
        >demo@rowan.fyi</code
      >.
    </p>
    <p class="evp-github-link">
      🧑‍💻 View the code for the demo on <a
        href="https://github.com/rowan-m/rowan-fyi/blob/main/src/pages/made/email-verification/index.astro"
        target="_blank">GitHub</a
      >
    </p>
    <p class="evp-instruction">Enter an email address to trigger verification.</p>
    <form method="POST" id="verify-form" class="evp-form">
      <div class="form-group">
        <label for="email">Email address:</label>
        <input type="email" id="email" name="email" autocomplete="email" placeholder="e.g. demo@rowan.fyi" required />
      </div>
      <!-- EVP Hidden Input with Server-Side Dynamic Nonce -->
      <input type="hidden" name="token" nonce={activeNonce} autocomplete="email-verification-token" />
      <button type="submit" id="submit-btn">Sign up</button>
    </form>

    {
      verificationResult && (
        <div class="msg-box success">
          <h3>🎉 Email successfully verified!</h3>
          <p>
            Verified email as: <strong>{verificationResult.email}</strong>
          </p>
        </div>
      )
    }

    {
      errorMsg && (
        <div class="msg-box error">
          <h3>⚠️ Verification failed.</h3>
          <p>{errorMsg}</p>
        </div>
      )
    }

    {
      activeTrace && (
        <div class="trace-container">
          <h2>Verification steps</h2>
          <p>Expand the sections to see debugging detail for each step:</p>

          <ol class="trace-list">
            {activeTrace.map((step) => {
              return (
                <li class={`trace-step ${step.status}`}>
                  <div class="trace-step-header">
                    <h3 class="trace-step-title">{step.name}</h3>
                    <span class="status-badge">{step.status}</span>
                  </div>

                  <p class="trace-step-desc">{step.description}</p>

                  {step.error && <p class="trace-step-error">Exception Details: {step.error}</p>}

                  {(step.serverCalled || step.inputSent || step.outputReceived) && (
                    <details class="trace-details">
                      <summary>Show debugging detail</summary>
                      <div class="trace-details-content">
                        {step.serverCalled && (
                          <p>
                            <strong>Server Called:</strong> <code>{step.serverCalled}</code>
                          </p>
                        )}

                        {step.inputSent && (
                          <div class="trace-section-mb">
                            <strong>Inputs Sent:</strong>
                            <pre>
                              <code>{JSON.stringify(step.inputSent, null, 2)}</code>
                            </pre>
                          </div>
                        )}

                        {step.outputReceived && (
                          <div class="trace-section-mb">
                            <strong>Outputs Received:</strong>
                            <pre>
                              <code>{JSON.stringify(step.outputReceived, null, 2)}</code>
                            </pre>
                          </div>
                        )}
                      </div>
                    </details>
                  )}
                </li>
              );
            })}
          </ol>
        </div>
      )
    }
  </main>

  <script>
    const form = document.getElementById("verify-form");
    const submitBtn = document.getElementById("submit-btn");

    if (form && submitBtn) {
      form.addEventListener("submit", () => {
        submitBtn.setAttribute("disabled", "true");
      });
    }

    // Direct check for Chrome and its major version
    const ua = navigator.userAgent;
    const isChrome = /Chrome\/(\d+)/i.test(ua) && !/Edg|OPR/i.test(ua);
    const match = isChrome ? ua.match(/Chrome\/(\d+)/i) : null;
    const version = match ? parseInt(match[1], 10) : 0;

    const browserEl = document.getElementById("ua-browser");
    const versionEl = document.getElementById("ua-version");
    const supportedEl = document.getElementById("ua-supported");

    if (browserEl && versionEl && supportedEl) {
      browserEl.textContent = isChrome ? "Chrome" : "an unsupported browser";
      versionEl.textContent = isChrome ? `${version}` : "";

      if (isChrome && version >= 150) {
        supportedEl.textContent = "supported";
        supportedEl.classList.add("ua-supported");
      } else {
        supportedEl.textContent = "not supported";
        supportedEl.classList.add("ua-unsupported");
      }
    }
  </script>
</MetaOnlyLayout>
