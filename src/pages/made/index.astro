---
export const prerender = true;

import fs from "node:fs";
import path from "node:path";
import DefaultHead from "@/components/DefaultHead.astro";
import DefaultBodyLayout from "@/layouts/DefaultBodyLayout.astro";

let astroDirs: string[] = [];
try {
  const astroPath = path.resolve("src/pages/made");
  astroDirs = fs
    .readdirSync(astroPath, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name);
} catch (e) {
  console.warn("Could not read src/pages/made directory", e);
}

const madeList = astroDirs
  .map((slug) => ({
    name: slug,
    href: `/made/${slug}/`,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<!doctype html>
<html lang="en">
  <DefaultHead title="Made by Rowan" description="Things I've made" />
  <DefaultBodyLayout>
    <main>
      <h1>Things I've made</h1>
      <p>
        A collection of interactive demos, web experiments, and small projects (many originally started on{" "}
        <a href="https://glitch.com">Glitch</a>). Feel free to ping me on your preferred social network if you find
        something that's broken.
      </p>
      <ul>
        {madeList.map((item) => <li>
          <a href={item.href}>{item.name}</a>
        </li>)}
      </ul>
    </main>
  </DefaultBodyLayout>
</html>
