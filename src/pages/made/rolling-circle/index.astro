---
export const prerender = true;

import MetaOnlyLayout from "@/layouts/MetaOnlyLayout.astro";
import ferrisImg from "./assets/ferris-wheel_1f3a1.png";
---

<MetaOnlyLayout
  title="Rolling circle 🎡 optical illusion"
  description="Each individual circle is just moving back and forth on a straight line, but the combined effect creates a larger rolling movement."
>
  <meta name="theme-color" content="slategray" />
  <link rel="shortcut icon" href={ferrisImg.src} />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Rolling circle 🎡 optical illusion" />
  <meta
    property="og:description"
    content="Each individual circle is just moving back and forth on a straight line, but the combined effect creates a larger rolling movement."
  />
  <style is:inline>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: sans-serif;
      margin: 0 2vw 0 2vw;
      padding: 0;
      background: black;
    }
    p {
      max-width: 80vw;
      color: silver;
    }
    a,
    a:visited {
      color: lightblue;
    }
    .container {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 80vh;
      max-width: 80vw;
      height: 80vw;
      max-height: 80vh;
      margin-left: 5vw;
    }
    .bar {
      position: absolute;
      width: 100%;
      height: 10vw;
      max-height: 10vh;
      background-image: linear-gradient(
        0deg,
        rgba(0, 0, 0, 0) 0,
        rgba(0, 0, 0, 0) 46%,
        rgba(173, 216, 230, 0.6) 50%,
        rgba(0, 0, 0, 0) 54%,
        rgba(0, 0, 0, 0) 100%
      );
      opacity: 0.01;
      animation: fade infinite 30s ease-in-out;
    }
    .circle {
      width: 10vh;
      max-width: 10vw;
      height: 10vw;
      max-height: 10vh;
      border-radius: 50%;
      border: 0.75rem solid blue;
      animation: slide infinite alternate 6s ease-in-out;
      opacity: 0.8;
    }
    @keyframes slide {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(700%);
      }
    }
    @keyframes fade {
      0% {
        opacity: 0.01;
      }
      5% {
        opacity: 0.01;
      }
      10% {
        opacity: 1;
      }
      60% {
        opacity: 1;
      }
      65% {
        opacity: 0.01;
      }
      100% {
        opacity: 0.01;
      }
    }
    .ba {
      transform: rotate(000deg);
    }
    .bb {
      transform: rotate(030deg);
      animation-delay: 4s;
    }
    .bc {
      transform: rotate(060deg);
      animation-delay: 8s;
    }
    .bd {
      transform: rotate(090deg);
      animation-delay: 2s;
    }
    .be {
      transform: rotate(120deg);
      animation-delay: 6s;
    }
    .bf {
      transform: rotate(150deg);
      animation-delay: 10s;
    }
    .ba > div {
      animation-delay: 0s;
      border-color: red;
      box-shadow: 0 0 0.5rem 0 red;
    }
    .bb > div {
      animation-delay: 1s;
      border-color: orange;
      box-shadow: 0 0 0.5rem 0 orange;
    }
    .bc > div {
      animation-delay: 2s;
      border-color: yellow;
      box-shadow: 0 0 0.5rem 0 yellow;
    }
    .bd > div {
      animation-delay: 3s;
      border-color: green;
      box-shadow: 0 0 0.5rem 0 green;
    }
    .be > div {
      animation-delay: 4s;
      border-color: blue;
      box-shadow: 0 0 0.5rem 0 blue;
    }
    .bf > div {
      animation-delay: 5s;
      border-color: indigo;
      box-shadow: 0 0 0.5rem 0 indigo;
    }
  </style>
  <p>
    Rolling Circles optical illusion. Each individual circle is just moving back and forth on a straight line, but the
    combined effect creates a larger movement. <a href="/posts/rolling-circles/">Read more on rowan.fyi</a> or
    <a href="https://github.com/rowan-m/rowan-fyi/blob/main/src/pages/made/rolling-circle/index.astro"
      >view the code on GitHub</a
    >.
  </p>

  <div class="container">
    <div class="bar ba"><div class="circle"></div></div>
    <div class="bar bb"><div class="circle"></div></div>
    <div class="bar bc"><div class="circle"></div></div>
    <div class="bar bd"><div class="circle"></div></div>
    <div class="bar be"><div class="circle"></div></div>
    <div class="bar bf"><div class="circle"></div></div>
  </div>
</MetaOnlyLayout>
