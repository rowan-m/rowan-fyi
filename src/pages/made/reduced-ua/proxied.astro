---
export const prerender = false;

import MetaOnlyLayout from "@/layouts/MetaOnlyLayout.astro";

const oldUA = Astro.request.headers.get("user-agent") ?? "";
---

<MetaOnlyLayout title="Proxy reduced user-agent" description="Proxy User-Agent reduction example.">
  <link rel="icon" href="data:;base64,iVBORw0KGgo=" />
  <style is:inline>
    body {
      font-family: sans-serif;
    }

    h1,
    h2 {
      font-size: 1rem;
    }

    code {
      font-weight: bold;
      background: oldlace;
    }

    .did-reduce {
      font-weight: bold;
    }
  </style>
  <h1>Proxy reduced user-agent</h1>
  <a href="/made/reduced-ua/">⬆ All examples</a>
  <dl>
    <dt>The <code>User-Agent</code> header received server-side:</dt>
    <dd><code class="old-ua">{oldUA}</code></dd>
  </dl>
  <h2>Code</h2>
  <p>
    <a href="https://glitch.com/edit/#!/reduced-ua?path=public%2Fproxied.html">Edit in Glitch</a>
  </p>
  <script is:inline>
    "use strict";
    if (location.protocol !== "https:" && location.hostname !== "localhost") {
      location.protocol = "https:";
    }
  </script></MetaOnlyLayout>
