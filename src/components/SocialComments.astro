---
import Bluesky from "/public/img/socials/bluesky-fill.svg";
import Mastodon from "/public/img/socials/mastodon-fill.svg";
import ShareButton from "@/components/ShareButton.astro";

interface Props {
  canonicalUrl: string;
  locationUrl?: string;
  blueskyUrl?: string;
  mastodonUrl?: string;
}

const { canonicalUrl, locationUrl, blueskyUrl, mastodonUrl } = Astro.props;
---

<section class="social-comments">
  <h2 id="comments">Comments</h2>
  <div class="comment-actions">
    <ShareButton />
    <a
      href={blueskyUrl || "https://bsky.app/profile/rowan.fyi"}
      title="rowan@fyi on Bluesky"
      class="button share-button"
      target="_blank"
      rel="noopener"><Bluesky /> Share/reply on Bluesky</a
    >
    <a
      href={mastodonUrl || "https://mastodon.social/@rowan_m"}
      title="@rowan_m on Mastodon"
      class="button share-button"
      target="_blank"
      rel="noopener"><Mastodon /> Share/reply on Mastodon</a
    >
  </div>

  <social-comments
    canonical-url={canonicalUrl}
    location-url={locationUrl || ""}
    bsky-url={blueskyUrl || ""}
    mastodon-url={mastodonUrl || ""}></social-comments>
</section>

<script>
  import "./social-comments/social-comments";
</script>

<style>
  .comment-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }

  .comment-actions :global(.button) {
    font-size: 0.85rem;
  }
</style>
